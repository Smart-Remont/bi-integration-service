# Database configs
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

DB_POOL_MIN_SIZE=
DB_POOL_MAX_SIZE=

# Big integration Basic Auth (POST /api/big_integration/*)
INTEGRATION_HS_BI_USER=hs_bi
INTEGRATION_HS_BI_PASSWORD=

# DDU export Basic Auth (GET /api/ddu_export/*) — separate credentials from BIG Integration
DDU_EXPORT_AUTH_USER=ddu_export
DDU_EXPORT_AUTH_PASSWORD=

# Kcell SMS (cron /api/sms/*) — Hermes send + batch status use different credentials in legacy PHP
KCELL_HERMES_BASE_URL=https://api-cpa.kcell.kz/hermes
KCELL_HERMES_USER=
KCELL_HERMES_PASSWORD=
KCELL_BATCH_BASE_URL=https://msg.kcell.kz/api/v3/batches
KCELL_BATCH_USER=
KCELL_BATCH_PASSWORD=

# Sberbank payment gateway (Sberbank.kz REST)
SBERBANK_USER=
SBERBANK_PASSWORD=
SBERBANK_PASSWORD_TEST=
SBERBANK_TEST_MODE=false

# Payments public base URL for return/redirect links (defaults to OFFICE_PUBLIC_URL)
PAYMENTS_PUBLIC_BASE_URL=

# Forte / Paybox — fallback if not in DB `public.get_setting_value_by_code`
FORTE_URL=
FORTE_MERCHANT=
PAYBOX_ENABLED=false
PAYBOX_MERCHANT=
PAYBOX_SALT=
PAYBOX_SECRET_KEY=
PAYBOX_INIT_URL=
PAYBOX_STATUS_URL=

# Installment internal API Basic Auth (GET/POST /api/v1/installment/ff/*, except webhook)
INSTALLMENT_API_USER=
INSTALLMENT_API_PASSWORD=

# Factoring MyNCA (client ЭЦП печатных форм). Same service as constructor ClientSignController.
MYNCA_BASE_URL=https://nca.smartremont.kz/api
MYNCA_TOKEN=
OFFICE_PUBLIC_URL=https://office.smartremont.kz
PUBLIC_BASE_URL=https://devintegration.smart-remont.kz

# --- File storage (MinIO only) ---
# Public URL prefix for stored files: STORAGE_PUBLIC_URL + /documents/...
# Empty falls back to OFFICE_PUBLIC_URL, then https://office.smartremont.kz
STORAGE_PUBLIC_URL=

# MinIO / S3 (smremont application.ini → minio.*)
MINIO_ENDPOINT=https://s3.smartremont.kz
MINIO_BUCKET=smartremont
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1

# Basic Auth for GET/POST /api/v1/storage/* (falls back to INSTALLMENT_API_*)
STORAGE_API_USER=
STORAGE_API_PASSWORD=
