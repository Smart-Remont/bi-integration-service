# Database configs
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

DB_POOL_MIN_SIZE=
DB_POOL_MAX_SIZE=

# Big integration Basic Auth (POST /api/big_integration/*)
INTEGRATION_HS_BI_USER=hs_bi
INTEGRATION_HS_BI_PASSWORD=

# Installment internal API Basic Auth (GET/POST /api/v1/installment/ff/*, except webhook)
INSTALLMENT_API_USER=
INSTALLMENT_API_PASSWORD=

# Factoring MyNCA (client ЭЦП печатных форм). Same service as constructor ClientSignController.
MYNCA_BASE_URL=https://nca.smartremont.kz/api
MYNCA_TOKEN=
OFFICE_PUBLIC_URL=https://office.smartremont.kz
PUBLIC_BASE_URL=https://devintegration.smart-remont.kz

# --- File storage (MinIO + legacy office proxy) ---
# Backend: office | minio | dual  (same idea as smremont application.ini → minio.storage_backend)
#   office = HTTP proxy to PHP /kanban/srfile-upload
#   minio  = direct PUT to MinIO (object key documents/...)
#   dual   = MinIO first, fallback to office unless MINIO_STRICT=1
STORAGE_BACKEND=office

# Public URL prefix for stored files: STORAGE_PUBLIC_URL + /documents/...
STORAGE_PUBLIC_URL=

# MinIO / S3 (smremont application.ini → minio.*)
MINIO_ENDPOINT=https://s3.smartremont.kz
MINIO_BUCKET=smartremont
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_STRICT=0

# Legacy office proxy (KanbanController srfile-upload) — STORAGE_BACKEND=office|dual
FILE_STORE_BASE_URL=
FILE_STORE_UPLOAD_PATH=/kanban/srfile-upload
FILE_STORE_USER=python
FILE_STORE_PASSWORD=
FILE_STORE_TIMEOUT_SECONDS=120

# Basic Auth for GET/POST /api/v1/storage/* (falls back to INSTALLMENT_API_*)
STORAGE_API_USER=
STORAGE_API_PASSWORD=
